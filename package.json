{
  "name": "nextjs-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm env:reset",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "env:up": "supabase start",
    "env:down": "supabase stop --no-backup",
    "env:reset": "supabase start && supabase db reset && pnpm seed && pnpm gen:types",
    "design:check": "npx --yes impeccable@4.1.0 detect --json app components",
    "api:check": "tsx scripts/openapi/generate.ts --check",
    "api:generate": "tsx scripts/openapi/generate.ts",
    "gen:types": "supabase gen types typescript --local > types/database.ts && prettier --write types/database.ts",
    "skills:check": "node scripts/skills/check-links.mjs",
    "seed": "tsx --env-file=.env.local scripts/supabase/seed.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^0.563.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
