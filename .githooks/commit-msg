#!/bin/sh
# commit-msg: checks a commit's first line (and a breaking change's trailer)
# against Conventional Commits. POSIX sh only, so it runs in repos with no
# Node. Deployed by chezmoi to ~/.config/git/hooks (global core.hooksPath).
TYPES="feat fix docs style refactor perf test build ci chore revert"
MAX=72

# Bytes, not the locale's characters: Git for Windows' grep and sed reject an
# astral character (an emoji) in a UTF-8 locale, so `.` would not match it.
# The rules are ASCII; the length is counted in characters below.
LC_ALL=C
export LC_ALL

# The first line that is neither blank nor one of git's comment lines.
line=$(sed -n '/^#/d; s/\r$//; /^$/d; p' "$1" | sed -n '1p')

# Exempt: merge commits and fixup!/squash! on an unmerged branch.
if printf '%s\n' "$line" | grep -Eq '^Merge (pull request|branch|remote-tracking branch|tag|commit|main|beta|[^ ]+ into) '; then exit 0; fi
if printf '%s\n' "$line" | grep -Eq '^(fixup|squash|amend)! '; then exit 0; fi
if printf '%s\n' "$line" | grep -Eq '^Revert "'; then exit 0; fi

problems=""
add() { problems="$problems
  - $1"; }

# Characters, not bytes: drop UTF-8 continuation bytes (0x80-0xBF).
len=$(printf '%s' "$line" | tr -d '\200-\277' | wc -c | tr -d ' ')
if [ "$len" -gt "$MAX" ]; then
  add "the first line is $len characters; at most $MAX"
fi

if printf '%s\n' "$line" | grep -Eq '^[A-Za-z]+(\([^)]*\))?!?: [^ ].*$'; then
  type=$(printf '%s\n' "$line" | sed -E 's/^([A-Za-z]+).*/\1/')
  case " $TYPES " in
    *" $type "*) ;;
    *) add "\`$type\` is not a type" ;;
  esac
  if printf '%s\n' "$line" | grep -Eq '^[A-Za-z]+\('; then
    scope=$(printf '%s\n' "$line" | sed -E 's/^[A-Za-z]+\(([^)]*)\).*/\1/')
    if ! printf '%s\n' "$scope" | grep -Eq '^[a-z0-9]+([-_./][a-z0-9]+)*$'; then
      add "scope ($scope) is not a lowercase area (review-loop)"
    fi
  fi
  subject=$(printf '%s\n' "$line" | sed -E 's/^[A-Za-z]+(\([^)]*\))?!?: //')
  if printf '%s\n' "$subject" | grep -Eq '\.$'; then add "the subject ends with a full stop"; fi
  if printf '%s\n' "$subject" | grep -Eq '\(#[0-9]+\)'; then add "the subject carries an issue reference (#n); put Refs: #n in the trailers"; fi
  if printf '%s\n' "$subject" | grep -Eq '^[A-Z][a-z]+([^A-Za-z0-9_]|$)'; then add "the subject's first word is capitalised; write it imperative, lower case"; fi
  if printf '%s\n' "$line" | grep -Eq '^[A-Za-z]+(\([^)]*\))?!: ' && ! grep -Eq '^BREAKING[ -]CHANGE: ' "$1"; then
    add "a breaking change (!) needs a BREAKING CHANGE: <what breaks, how to migrate> trailer"
  fi
else
  add "\`$line\` is not <type>(<scope>)<!>: <subject>"
fi

[ -z "$problems" ] && exit 0

cat >&2 <<MSG
commit-msg: this commit message does not follow the commit standard:$problems

Rule: <type>(<scope>)<!>: <subject>, first line at most $MAX characters,
      imperative, lower case first word, no trailing full stop.
Types: $TYPES
Scope: optional, a lowercase area (review-loop).
Example: fix(auth): refuse an expired session token
Standard: https://www.conventionalcommits.org
MSG
exit 1
